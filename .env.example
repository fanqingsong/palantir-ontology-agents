TAVILY_API_KEY=
# Required to click Run Analysis (OpenAI-compatible key)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# memory | postgres | neo4j | dual — docker compose app service forces dual regardless
ONTOLOGY_BACKEND=dual
DATABASE_URL=postgresql://ontology:ontology@localhost:5432/ontology
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ontology-dev

# dual mode: async projection via Prefect (Compose). Set true to flush on every write locally.
OUTBOX_SYNC_FLUSH=false

# Agentic graph search and entity linking
GRAPH_SEARCH_MODE=agentic
GRAPH_SEARCH_MAX_ROUNDS=6
GRAPH_SEARCH_ROW_LIMIT=100
ENTITY_LINK_CANDIDATE_LIMIT=20
ENTITY_LINK_QUERY_THRESHOLD=0.72
ENTITY_LINK_WRITE_THRESHOLD=0.90
ENTITY_LINK_NEW_MIN_CONFIDENCE=0.90
ENTITY_LINK_REVIEW_GAP=0.08

# Prefect self-hosted (outbox worker stack)
PREFECT_API_URL=http://localhost:4200/api
# Compose sets PREFECT_SERVER_UI_API_URL so the dashboard talks to localhost, not 0.0.0.0
PREFECT_OUTBOX_DEPLOYMENT=project-outbox-row/project-outbox-row
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_OUTBOX_TOPIC=ontology.public.outbox
